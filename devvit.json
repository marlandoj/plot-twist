{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "plot-twist",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "height": "tall",
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Plot Twist: post today's street",
        "description": "Creates today's daily puzzle post if it is not up yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Plot Twist: review resident suggestions",
        "description": "Approve the community residents who move in next",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/review-suggestions"
      }
    ]
  },
  "forms": {
    "reviewSuggestion": "/internal/form/review-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-rollover": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "0 0 * * *"
      },
      "mayors-wall": {
        "endpoint": "/internal/scheduler/mayors-wall",
        "cron": "15 0 * * 1"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
