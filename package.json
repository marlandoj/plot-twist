{
  "private": true,
  "name": "plot-twist",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "tsx preview/standalone.ts",
    "dev": "devvit playtest",
    "deploy": "npm run test:types && npm test && devvit upload",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login",
    "test": "vitest run",
    "test:types": "tsc --build",
    "queue": "tsx scripts/generate-queue.ts",
    "playthrough": "vitest run tests/playthrough.test.tsx --reporter=verbose",
    "bundle-report": "vite build && tsx scripts/bundle-report.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
